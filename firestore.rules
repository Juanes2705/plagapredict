rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Colección "users": cada usuario solo lee/escribe su propio documento
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Colección "reportes":
    //   - Crear: cualquier usuario autenticado
    //   - Leer:  cualquier usuario autenticado
    //   - Editar/Eliminar: solo el propio creador o un admin
    match /reportes/{reporteId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null;
      allow update, delete: if request.auth != null &&
        (request.auth.uid == resource.data.uid_reportador ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Colección "geocercas" (HU-15):
    //   - Leer: cualquier usuario autenticado (para ver zonas en el mapa)
    //   - Crear/Editar/Eliminar: solo administradores
    match /geocercas/{geoId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
